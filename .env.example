# AI World Engine - Environment Configuration
# Copy this file to .env and fill in your values

# AI API Configuration (OpenAI-compatible)
# If AI_API_KEY is empty or not set, the system will use mock AI mode
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# Database Configuration
DATABASE_URL=sqlite:///./data/ai_world_engine.db

# Application Configuration
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
